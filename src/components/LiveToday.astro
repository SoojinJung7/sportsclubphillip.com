---
// "오늘의 라이브" — real-time KST clock + open status + current/next GX class.
// Schedule is CMS-editable in content/gx-schedule.json
import gx from '../../content/gx-schedule.json';
---

<section class="relative -mt-1 bg-ink text-white">
  <div class="mx-auto max-w-7xl px-5 lg:px-8 py-6 lg:py-7">
    <div id="live-today" data-empty-msg="오늘은 GX 수업이 없어요 · 헬스장은 05:30–23:00 운영">
      <!-- Header row -->
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <span class="inline-flex items-center gap-2 text-[12px] font-bold tracking-[0.2em] text-sand">
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-500 opacity-70"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-red-500"></span>
          </span>
          LIVE · 오늘의 필립
        </span>
        <span class="flex items-baseline gap-2">
          <span id="lt-clock" class="text-xl lg:text-2xl font-bold tabular-nums tracking-tight">--:--:--</span>
          <span class="text-[11px] text-white/50">KST</span>
          <span id="lt-date" class="text-[13px] text-white/60 ml-1"></span>
        </span>
        <span id="lt-badge" class="ml-auto px-3 py-1.5 rounded-full text-[12px] font-semibold bg-white/10">···</span>
      </div>

      <!-- Current / next class -->
      <div id="lt-summary" class="mt-4"></div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ SCHEDULE: gx.days }}>
  (function () {
    const root = document.getElementById('live-today');
    if (!root) return;
    const DAY = ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'];
    const KO = ['일', '월', '화', '수', '목', '금', '토'];
    const pad = (n) => String(n).padStart(2, '0');
    const toMin = (t) => { const p = t.split(':'); return +p[0] * 60 + +p[1]; };
    const kst = () => new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Seoul' }));

    const clockEl = document.getElementById('lt-clock');
    const dateEl = document.getElementById('lt-date');
    const badgeEl = document.getElementById('lt-badge');
    const summaryEl = document.getElementById('lt-summary');

    function classHTML(c) {
      return '<span class="inline-flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full" style="background:'
        + (c.paid ? '#5b9bd5' : '#e0b878') + '"></span><b class="font-semibold">' + c.name + '</b>'
        + '<span class="text-white/55 text-[13px]">' + (c.instructor || '') + ' · ' + c.floor + (c.paid ? ' · 유료' : '') + '</span></span>';
    }
    function card(label, list, live) {
      const time = list[0].start;
      const items = list.map(classHTML).join('<span class="mx-2 text-white/25">/</span>');
      return '<div class="flex flex-wrap items-center gap-x-3 gap-y-2">'
        + '<span class="px-2.5 py-1 rounded-md text-[11px] font-bold tracking-wide ' + (live ? 'bg-red-500 text-white' : 'bg-sand text-ink') + '">' + label + '</span>'
        + '<span class="text-[16px] font-bold tabular-nums">' + time + '</span>'
        + '<span class="text-[14px] flex flex-wrap items-center gap-x-1 gap-y-1">' + items + '</span></div>';
    }

    function render() {
      const d = kst();
      const dayKey = DAY[d.getDay()];
      const nowMin = d.getHours() * 60 + d.getMinutes() + d.getSeconds() / 60;

      clockEl.textContent = pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());
      dateEl.textContent = (d.getMonth() + 1) + '.' + d.getDate() + ' (' + KO[d.getDay()] + ')';

      // open status (gym 05:30–23:00; closed 1st/3rd/5th Sundays)
      const nth = Math.ceil(d.getDate() / 7);
      const closedDay = d.getDay() === 0 && (nth === 1 || nth === 3 || nth === 5);
      const open = !closedDay && nowMin >= 330 && nowMin < 1380;
      badgeEl.textContent = closedDay ? '오늘 휴관일' : open ? '● 지금 영업 중' : '영업 종료';
      badgeEl.className = 'ml-auto px-3 py-1.5 rounded-full text-[12px] font-semibold '
        + (open ? 'bg-emerald-500/20 text-emerald-300' : 'bg-white/10 text-white/60');

      const list = (SCHEDULE[dayKey] || []).slice().sort((a, b) => toMin(a.start) - toMin(b.start));
      if (!list.length) {
        summaryEl.innerHTML = '<p class="text-[14px] text-white/70">' + root.dataset.emptyMsg + '</p>';
        return;
      }

      // group into time slots, find current & next
      const slots = [];
      for (const c of list) {
        const last = slots[slots.length - 1];
        if (last && last.start === c.start) last.items.push(c);
        else slots.push({ start: c.start, items: [c] });
      }
      const cur = slots.find((s) => nowMin >= toMin(s.start) && nowMin < toMin(s.start) + 50);
      const next = slots.find((s) => toMin(s.start) > nowMin);

      let html = '';
      if (cur) html += card('지금 진행 중', cur.items, true);
      if (next) {
        const nextCard = card('다음 수업', next.items, false);
        html += cur ? '<div class="mt-2 opacity-80">' + nextCard + '</div>' : nextCard;
      }
      if (!cur && !next) html += '<p class="text-[14px] text-white/70">오늘 예정된 GX 수업이 모두 끝났어요. 내일 또 만나요! 💪</p>';
      summaryEl.innerHTML = html;
    }

    render();
    setInterval(render, 1000);
  })();
</script>
