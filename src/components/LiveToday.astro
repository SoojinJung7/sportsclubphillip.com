---
// "오늘의 라이브" — real-time KST clock + open status + today's GX & Swimming.
// Schedules are CMS-editable in content/gx-schedule.json & content/swimming-schedule.json
// 휴관일 · 공휴일 · 시설 운영시간은 content/operating-calendar.json (src/data/operating.ts) 담당.
---

<section class="relative -mt-1 bg-ink text-white">
  <div class="mx-auto max-w-7xl px-5 lg:px-8 py-6 lg:py-7">
    <div id="live-today">
      <!-- Header row -->
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <span class="inline-flex items-center gap-2 text-[12px] font-bold tracking-[0.2em] text-sand">
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-500 opacity-70"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-red-500"></span>
          </span>
          LIVE · 오늘의 필립
        </span>
        <span class="flex items-baseline gap-2">
          <span id="lt-clock" class="text-xl lg:text-2xl font-bold tabular-nums tracking-tight">--:--:--</span>
          <span class="text-[11px] text-white/50">KST</span>
          <span id="lt-date" class="text-[13px] text-white/60 ml-1"></span>
        </span>
        <span class="ml-auto flex items-center gap-2">
          <span id="lt-sauna" class="px-3 py-1.5 rounded-full text-[12px] font-semibold bg-white/10">···</span>
          <span id="lt-badge" class="px-3 py-1.5 rounded-full text-[12px] font-semibold bg-white/10">···</span>
        </span>
      </div>

      <!-- Two columns: GX | Swimming (stacks on mobile) -->
      <div class="mt-6 grid gap-x-10 gap-y-6 lg:grid-cols-2">
        <div>
          <h3 class="flex items-center gap-2 text-[12px] font-bold tracking-[0.15em] text-white/75 mb-3">
            <span class="w-2 h-2 rounded-full" style="background:#e0b878"></span>GX 클래스
          </h3>
          <div id="lt-gx"></div>
        </div>
        <div class="lg:border-l lg:border-white/10 lg:pl-10">
          <h3 class="flex items-center gap-2 text-[12px] font-bold tracking-[0.15em] text-white/75 mb-3">
            <span class="w-2 h-2 rounded-full" style="background:#22c1cc"></span>수영 강습
          </h3>
          <div id="lt-swim"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import gxData from '../../content/gx-schedule.json';
  import swimData from '../../content/swimming-schedule.json';
  import { facilityBy, isClosedDay, isClubOpen, isFacilityOpen, isHoliday, kstNow, toMin } from '../data/operating';

  type Klass = { start: string; name: string; instructor?: string; floor?: string; paid?: boolean; level?: string };
  const GX = gxData.days as Record<string, Klass[]>;
  const SWIM = swimData.days as Record<string, Klass[]>;

  const root = document.getElementById('live-today');
  if (root) {
    const DAY = ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'];
    const KO = ['일', '월', '화', '수', '목', '금', '토'];
    const SLOT = 50; // minutes considered "in progress"
    const pad = (n: number) => String(n).padStart(2, '0');

    const clockEl = document.getElementById('lt-clock')!;
    const dateEl = document.getElementById('lt-date')!;
    const badgeEl = document.getElementById('lt-badge')!;
    const saunaEl = document.getElementById('lt-sauna')!;
    const gxEl = document.getElementById('lt-gx')!;
    const swimEl = document.getElementById('lt-swim')!;

    const sauna = facilityBy('사우나');

    const chip = (label: string, live: boolean, cls: string) =>
      '<span class="px-2.5 py-1 rounded-md text-[11px] font-bold tracking-wide ' + (live ? 'bg-red-500 text-white' : cls) + '">' + label + '</span>';
    const time = (t: string) => '<span class="text-[16px] font-bold tabular-nums">' + t + '</span>';
    const note = (msg: string) => '<p class="text-[14px] text-white/60">' + msg + '</p>';

    // GX: each class = dot + name + (instructor · floor · 유료)
    function gxCard(label: string, list: Klass[], live: boolean) {
      const items = list.map((c) => {
        const meta = [c.instructor, c.floor, c.paid ? '유료' : null].filter(Boolean).join(' · ');
        return '<span class="inline-flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full" style="background:'
          + (c.paid ? '#5b9bd5' : '#e0b878') + '"></span><b class="font-semibold">' + c.name + '</b>'
          + (meta ? '<span class="text-white/55 text-[13px]">' + meta + '</span>' : '') + '</span>';
      }).join('<span class="mx-1.5 text-white/25">/</span>');
      return '<div class="flex flex-wrap items-center gap-x-2.5 gap-y-1.5">' + chip(label, live, 'bg-sand text-ink')
        + time(list[0].start) + '<span class="text-[14px] flex flex-wrap items-center gap-x-1 gap-y-1">' + items + '</span></div>';
    }

    // Swim: group name once, then "반 강사" pairs
    function swimCard(label: string, list: Klass[], live: boolean) {
      const items = list.map((c) => {
        const lv = c.level ? '<b class="font-medium text-white/85">' + c.level + '</b> ' : '';
        return '<span class="whitespace-nowrap">' + lv + '<span class="text-white/55">' + (c.instructor || '') + '</span></span>';
      }).join('<span class="mx-1.5 text-white/20">·</span>');
      return '<div class="flex flex-wrap items-center gap-x-2.5 gap-y-1.5">' + chip(label, live, 'bg-[#22c1cc] text-ink')
        + time(list[0].start)
        + '<span class="inline-flex items-center gap-1.5 text-[14px]"><span class="w-1.5 h-1.5 rounded-full" style="background:#22c1cc"></span><b class="font-semibold">' + list[0].name + '</b></span>'
        + '<span class="text-[13px] flex flex-wrap items-center gap-x-1 gap-y-1">' + items + '</span></div>';
    }

    function track(
      el: HTMLElement,
      sched: Record<string, Klass[]>,
      dayKey: string,
      nowMin: number,
      upLabel: string,
      cardFn: (label: string, list: Klass[], live: boolean) => string,
      emptyHtml: string,
    ) {
      const list = (sched[dayKey] || []).slice().sort((a, b) => toMin(a.start) - toMin(b.start));
      if (!list.length) { el.innerHTML = emptyHtml; return; }
      const slots: { start: string; items: Klass[] }[] = [];
      for (const c of list) {
        const last = slots[slots.length - 1];
        if (last && last.start === c.start) last.items.push(c);
        else slots.push({ start: c.start, items: [c] });
      }
      const cur = slots.find((s) => nowMin >= toMin(s.start) && nowMin < toMin(s.start) + SLOT);
      const upcoming = slots.filter((s) => toMin(s.start) > nowMin).slice(0, 2);
      const rows: string[] = [];
      if (cur) rows.push(cardFn('진행 중', cur.items, true));
      upcoming.forEach((s) => rows.push(cardFn(upLabel, s.items, false)));
      if (!rows.length) rows.push(note('오늘 예정된 수업이 모두 끝났어요 💪'));
      el.innerHTML = rows.map((r, i) => (i === 0 ? r : '<div class="mt-2' + (i > 1 ? ' opacity-70' : '') + '">' + r + '</div>')).join('');
    }

    function render() {
      const d = kstNow();
      const dayKey = DAY[d.getDay()];
      const nowMin = d.getHours() * 60 + d.getMinutes() + d.getSeconds() / 60;
      const closed = isClosedDay(d);
      const holiday = isHoliday(d);

      clockEl.textContent = pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());
      dateEl.textContent = (d.getMonth() + 1) + '.' + d.getDate() + ' (' + KO[d.getDay()] + ')';

      const open = isClubOpen(d);
      badgeEl.textContent = closed ? '오늘 휴관일' : open ? '● 지금 영업 중' : '영업 종료';
      badgeEl.className = 'px-3 py-1.5 rounded-full text-[12px] font-semibold '
        + (open ? 'bg-emerald-500/20 text-emerald-300' : 'bg-white/10 text-white/60');

      // Sauna badge — 사우나 자체 운영시간 기준.
      const saunaOpen = !!sauna && isFacilityOpen(sauna, d);
      saunaEl.textContent = saunaOpen ? '♨️ 사우나 영업 중' : '♨️ 사우나 운영 종료';
      saunaEl.className = 'px-3 py-1.5 rounded-full text-[12px] font-semibold '
        + (saunaOpen ? 'bg-amber-500/20 text-amber-200' : 'bg-white/10 text-white/60');

      // 휴관일엔 수업이 없고, 공휴일엔 수영강습·GX를 운영하지 않습니다.
      if (closed) {
        gxEl.innerHTML = note('오늘은 휴관일입니다 🏖️');
        swimEl.innerHTML = note('오늘은 휴관일입니다 🏖️');
      } else if (holiday) {
        gxEl.innerHTML = note('공휴일에는 GX 프로그램을 운영하지 않습니다 🎌');
        swimEl.innerHTML = note('공휴일에는 수영 강습을 운영하지 않습니다 🎌');
      } else {
        track(gxEl, GX, dayKey, nowMin, '예정 GX', gxCard, note('오늘은 GX 수업이 없어요 💤'));
        track(swimEl, SWIM, dayKey, nowMin, '예정 수영', swimCard, note('오늘은 수영 강습이 없어요 💤'));
      }
    }

    render();
    setInterval(render, 1000);
  }
</script>
