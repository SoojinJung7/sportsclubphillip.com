---
// 실시간 시설별 영업 현황 (KST) — 헬스장 / 사우나 / 수영장 각각의 오픈 여부.
// 시간·휴관일은 content/operating-calendar.json 한 곳에서만 관리합니다.
import { facilities } from '../data/operating';
---

<div id="fac-status" class="overflow-hidden rounded-2xl border border-line/80 bg-white/70 shadow-sm backdrop-blur-sm divide-y divide-line">
  {facilities.map((f) => (
    <div data-fac={f.label} class="flex items-center justify-between gap-4 px-5 py-3.5">
      <div class="flex items-center gap-3">
        <span class="h-2.5 w-2.5 shrink-0 rounded-full" style={`background:${f.color}`}></span>
        <span class="text-[14px] font-semibold text-ink">{f.label}</span>
      </div>
      <span class="fac-badge rounded-full bg-line/60 px-3 py-1 text-[12px] font-bold text-muted">···</span>
    </div>
  ))}
</div>

<script>
  import { facilityBy, isClosedDay, isFacilityOpen, kstNow } from '../data/operating';

  const root = document.getElementById('fac-status');
  if (root) {
    const rows = [...root.querySelectorAll<HTMLElement>('[data-fac]')];

    const render = () => {
      const d = kstNow();
      const closed = isClosedDay(d);

      for (const row of rows) {
        const f = facilityBy(row.dataset.fac || '');
        const badge = row.querySelector('.fac-badge');
        if (!f || !badge) continue;
        const open = isFacilityOpen(f, d);
        badge.textContent = closed && !f.openOnClosedDay ? '휴관일' : open ? '● 영업 중' : '영업 종료';
        badge.className = 'fac-badge rounded-full px-3 py-1 text-[12px] font-bold '
          + (open ? 'bg-emerald-500/15 text-emerald-700' : 'bg-line/60 text-muted');
      }
    };

    render();
    setInterval(render, 30000);
  }
</script>
