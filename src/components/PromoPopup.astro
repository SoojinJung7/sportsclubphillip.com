---
// Content is CMS-edited in content/popup.json
import popup from '../../content/popup.json';
import { imgSrc, imgAlt, type ImgKey } from '../data/site';
const { enabled, title, image, link } = popup;
const imgKey = image as ImgKey;
---

{enabled && (
<div id="promo-popup" class="fixed z-[60] bottom-4 right-4 w-[280px] sm:w-[320px] hidden">
  <div class="bg-white rounded-xl shadow-2xl border border-line overflow-hidden">
    <div class="flex items-center justify-between px-4 py-2.5 bg-ink text-white">
      <span class="text-[13px] font-semibold tracking-wide">{title}</span>
      <button id="promo-close" aria-label="닫기" class="text-white/70 hover:text-white text-lg leading-none">&times;</button>
    </div>
    <a href={link} class="block">
      <img src={imgSrc(imgKey)} alt={imgAlt(imgKey)} class="w-full h-auto" loading="lazy" />
    </a>
    <div class="flex items-center justify-between px-4 py-2.5 text-[12px] bg-cream">
      <button id="promo-hide-today" class="text-ink-soft hover:text-ink">오늘 하루 보지 않기</button>
      <a href={link} class="font-semibold text-sand-dark hover:underline">자세히 보기 →</a>
    </div>
  </div>
</div>
)}

<script>
  const KEY = 'scp-promo-popup-hidden-until';
  const popup = document.getElementById('promo-popup');
  const hiddenUntil = Number(localStorage.getItem(KEY) || 0);
  if (popup && Date.now() > hiddenUntil) {
    setTimeout(() => popup.classList.remove('hidden'), 600);
  }
  document.getElementById('promo-close')?.addEventListener('click', () => popup?.classList.add('hidden'));
  document.getElementById('promo-hide-today')?.addEventListener('click', () => {
    localStorage.setItem(KEY, String(Date.now() + 24 * 60 * 60 * 1000));
    popup?.classList.add('hidden');
  });
</script>
