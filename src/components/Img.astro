---
// Renders a site image by its key.
// Priority: CMS upload/override (content/media.json src) → build-time optimized
// local asset (astro:assets → responsive WebP) → remote fallback. `alt` defaults
// to the CMS-editable alt text but can be overridden per usage.
import { Image } from 'astro:assets';
import { localImg, imgOverride, imgSrc, imgAlt, type ImgKey } from '../data/site';

interface Props {
  k: ImgKey;
  alt?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  widths?: number[];
  sizes?: string;
}
const { k, alt, class: className, loading = 'lazy', widths, sizes } = Astro.props;
const override = imgOverride(k); // CMS-uploaded path/URL, if any
const meta = override ? null : localImg(k);
const altText = alt ?? imgAlt(k);
// astro:assets requires `sizes` whenever `widths` is given.
const responsive = widths && sizes ? { widths, sizes } : {};
---
{
  meta ? (
    <Image src={meta} alt={altText} class={className} loading={loading} {...responsive} />
  ) : (
    <img src={override ?? imgSrc(k)} alt={altText} class={className} loading={loading} />
  )
}
