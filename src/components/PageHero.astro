---
interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
}
const { eyebrow, title, subtitle } = Astro.props;
---

<section class="relative pt-36 lg:pt-48 pb-14 lg:pb-20 bg-cream overflow-hidden">
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-sand/10 blur-3xl"></div>
  </div>
  <div class="relative mx-auto max-w-7xl px-5 lg:px-8 text-center">
    <p class="eyebrow text-[12px] text-sand-dark font-semibold reveal">{eyebrow}</p>
    <h1 class="mt-4 text-3xl lg:text-5xl font-bold text-ink reveal">{title}</h1>
    {subtitle && <p class="mt-5 max-w-2xl mx-auto text-[15px] lg:text-base leading-relaxed text-ink-soft reveal">{subtitle}</p>}
    <div class="mt-8 w-12 h-px bg-sand mx-auto reveal"></div>
  </div>
</section>
