---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';
import { SITE, imgSrc, localImg } from '../data/site';
import { EN } from '../i18n/dict';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = `${SITE.tagline} ㅣ ${SITE.name}`,
  description = '분당 정자동 토탈 휘트니스 스포츠클럽필립 — 헬스, PT, GX, 기구 필라테스, 스크린 골프, 수영장, 유소년 스포츠, 사우나까지 한 공간에서.',
} = Astro.props;
const site = Astro.site ?? 'https://sportsclubphillip.com';
const canonical = new URL(Astro.url.pathname, site).href;
// Local logo → PNG for the favicon (broad support) and an absolute og:image URL.
const logoMeta = localImg('logo');
const logoPng = logoMeta ? await getImage({ src: logoMeta, format: 'png', width: 512 }) : null;
const faviconHref = logoPng?.src ?? imgSrc('logo');
const ogImage = logoPng ? new URL(logoPng.src, site).href : imgSrc('logo');
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ko_KR" />
    <meta name="theme-color" content="#16130f" />
    <link rel="icon" href={faviconHref} />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Client-side KR/EN toggle -->
    <script is:inline define:vars={{ DICT: EN }}>
      (function () {
        const KEY = 'scp-lang';
        let records = null;
        function collect() {
          records = [];
          const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
          let n;
          while ((n = walker.nextNode())) {
            const raw = n.nodeValue;
            if (!raw) continue;
            const key = raw.trim();
            if (key && Object.prototype.hasOwnProperty.call(DICT, key)) {
              records.push({ node: n, ko: raw, key: key });
            }
          }
        }
        function apply(lang) {
          if (!records) collect();
          for (const r of records) {
            r.node.nodeValue = lang === 'en' ? r.ko.replace(r.key, DICT[r.key]) : r.ko;
          }
          document.documentElement.lang = lang === 'en' ? 'en' : 'ko';
          document.querySelectorAll('[data-lang-btn]').forEach(function (b) {
            b.classList.toggle('lang-active', b.getAttribute('data-lang-btn') === lang);
          });
        }
        window.__setLang = function (lang) {
          try { localStorage.setItem(KEY, lang); } catch (e) {}
          apply(lang);
        };
        const saved = (function () { try { return localStorage.getItem(KEY); } catch (e) { return null; } })() || 'ko';
        if (document.readyState !== 'loading') apply(saved);
        else document.addEventListener('DOMContentLoaded', function () { apply(saved); });
      })();
    </script>

    <script>
      // Reveal-on-scroll
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12 },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
