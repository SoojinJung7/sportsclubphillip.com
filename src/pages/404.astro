---
import Base from '../layouts/Base.astro';
---

<Base title="페이지를 찾을 수 없습니다 ㅣ 스포츠클럽필립">
  <section class="min-h-[60vh] flex items-center">
    <div class="mx-auto max-w-xl px-5 lg:px-8 text-center pt-32 pb-20">
      <p class="text-6xl font-bold text-sand">404</p>
      <h1 class="mt-6 text-2xl font-bold text-ink">페이지를 찾을 수 없습니다</h1>
      <p class="mt-4 text-[15px] text-ink-soft">요청하신 페이지가 이동되었거나 존재하지 않습니다.</p>
      <a href="/" class="mt-8 inline-block px-8 py-3.5 text-[14px] font-semibold text-white bg-ink hover:bg-sand-dark rounded-full transition-colors">홈으로 돌아가기</a>
    </div>
  </section>
</Base>
