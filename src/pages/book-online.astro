---
import { EXTERNAL } from '../data/site';
// 온라인예약은 네이버 예약으로 연결됩니다.
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${EXTERNAL.naverBooking}`} />
    <title>온라인예약 ㅣ 스포츠클럽필립</title>
    <link rel="canonical" href={EXTERNAL.naverBooking} />
  </head>
  <body style="font-family: sans-serif; text-align: center; padding: 4rem 1rem;">
    <p>네이버 예약 페이지로 이동합니다…</p>
    <p><a href={EXTERNAL.naverBooking}>바로 이동하지 않으면 여기를 클릭하세요.</a></p>
    <script is:inline define:vars={{ url: EXTERNAL.naverBooking }}>
      window.location.replace(url);
    </script>
  </body>
</html>
