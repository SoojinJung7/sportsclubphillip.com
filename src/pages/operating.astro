---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { SITE, EXTERNAL } from '../data/site';
import c from '../../content/pages/operating.json';

import { closedNotice } from '../data/operating';

const facilityHours = c.facilityHours;
// 이번 달 실제 휴관일·공휴일 (content/operating-calendar.json). 없으면 일반 문구로 폴백.
const monthNotice = closedNotice();
const mapEmbed = 'https://www.google.com/maps?q=' + encodeURIComponent('경기도 성남시 내정로58') + '&output=embed';
---

<Base title={c.title}>
  <PageHero eyebrow="Location & Hours" title={c.hero.title} subtitle={c.hero.subtitle} />

  <section class="py-16 lg:py-24">
    <div class="mx-auto max-w-6xl px-5 lg:px-8 grid lg:grid-cols-2 gap-10 lg:gap-14">
      <!-- Map + address -->
      <div class="reveal">
        <div class="rounded-xl overflow-hidden border border-line shadow-sm aspect-[4/3]">
          <iframe src={mapEmbed} title={c.mapTitle} width="100%" height="100%" style="border:0" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
        <div class="mt-6">
          <p class="text-lg font-bold text-ink">{SITE.name}</p>
          <p class="mt-2 text-[15px] text-ink-soft">{SITE.address}</p>
          <div class="mt-5 flex flex-wrap gap-3">
            <a href={EXTERNAL.naverMap} target="_blank" rel="noopener" class="px-5 py-2.5 text-[13px] font-semibold text-white bg-ink hover:bg-sand-dark rounded-full transition-colors">{c.naverMapCta}</a>
            <a href={`tel:${SITE.phone}`} class="px-5 py-2.5 text-[13px] font-semibold text-ink border border-line hover:border-sand rounded-full transition-colors">{c.phoneLabel}{SITE.phone}</a>
          </div>
        </div>
      </div>

      <!-- Hours -->
      <div class="reveal">
        <h2 class="text-xl font-bold text-ink">{c.hoursHeading}</h2>
        <div class="mt-6 divide-y divide-line border border-line rounded-xl overflow-hidden">
          {facilityHours.map((f) => (
            <div class="flex items-center justify-between gap-4 px-5 py-4">
              <span class="text-[14px] font-medium text-ink">{f.name}</span>
              <span class="text-right text-[14px] text-ink-soft">
                {f.rows[0]}{f.rows[1] && <><br /><span class="text-[12px] text-muted">{f.rows[1]}</span></>}
              </span>
            </div>
          ))}
        </div>
        <div class="mt-5 p-4 bg-cream rounded-lg text-[13px] text-ink-soft leading-relaxed">
          <p>
            <strong class="text-ink">{c.notice.closedTitle}</strong>
            {monthNotice ? ` · ${monthNotice.month} ${monthNotice.closed}` : c.notice.closedText}
          </p>
          {monthNotice?.holidays && <p class="mt-1">공휴일 · {monthNotice.holidays}</p>}
          <p class="mt-1">{c.notice.holiday}</p>
        </div>

        <h2 class="mt-10 text-xl font-bold text-ink">{c.supportHeading}</h2>
        <div class="mt-4 space-y-2">
          {SITE.hours.map((h) => (
            <div class="flex items-center gap-4 text-[14px]">
              <span class="w-16 text-muted">{h.d}</span>
              <span class="text-ink-soft">{h.t}</span>
            </div>
          ))}
        </div>
        <ul class="mt-8 space-y-1.5 text-[14px] text-ink-soft">
          <li>Phone. <a href={`tel:${SITE.phone}`} class="hover:text-sand-dark">{SITE.phone}</a></li>
          <li>Fax. {SITE.fax}</li>
          <li>E-mail. <a href={`mailto:${SITE.email}`} class="hover:text-sand-dark">{SITE.email}</a></li>
        </ul>
      </div>
    </div>
  </section>
</Base>
