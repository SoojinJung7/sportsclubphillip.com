---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { EXTERNAL } from '../data/site';
import Img from '../components/Img.astro';
import c from '../../content/pages/swimminglesson.json';
// 매월 수영 스케줄 포스터 교체: Pages CMS "📅 이달의 포스터" 페이지에서 업로드하면 됩니다 (코드 수정 불필요).
---

<Base title={c.title}>
  <PageHero eyebrow="Swimming Lessons" title={c.hero.title}
    subtitle={c.hero.subtitle} />

  <section class="py-16 lg:py-24">
    <div class="mx-auto max-w-4xl px-5 lg:px-8 space-y-16">
      <div class="reveal text-center">
        <div class="rounded-2xl overflow-hidden shadow-xl border border-line inline-block">
          <Img k="swimmingNotice" class="w-full h-auto" />
        </div>
        <div class="mt-6">
          <a href={EXTERNAL.kakao} target="_blank" rel="noopener" class="px-8 py-3.5 text-[14px] font-semibold text-white bg-ink hover:bg-sand-dark rounded-full transition-colors">{c.ctaInquiry}</a>
        </div>
      </div>

      <div class="reveal">
        <h2 class="text-xl lg:text-2xl font-bold text-ink text-center">{c.schedule.heading}</h2>
        <p class="mt-3 text-center text-[13px] text-muted">{c.schedule.notice}</p>
        <div class="mt-8 rounded-2xl overflow-hidden shadow-xl border border-line">
          <Img k="swimmingSchedule" class="w-full h-auto" />
        </div>
      </div>

      <div class="reveal p-6 bg-cream rounded-xl text-center">
        <p class="text-[15px] font-semibold text-ink">{c.freeSwim.heading}</p>
        <p class="mt-2 text-[14px] text-ink-soft">{c.freeSwim.desc}</p>
      </div>
    </div>
  </section>
</Base>
