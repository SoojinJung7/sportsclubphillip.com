---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { EXTERNAL, imgSrc, imgAlt } from '../data/site';
// 매월 수영 스케줄 포스터 교체: site.ts 의 swimmingSchedule / swimmingNotice 이미지를 교체하세요.
---

<Base title="수영 강습 스케줄 ㅣ 스포츠클럽필립">
  <PageHero eyebrow="Swimming Lessons" title="수영 강습 스케줄"
    subtitle="건강한 수영 습관을 위한, 전문 코칭 기반의 정규 강습 프로그램" />

  <section class="py-16 lg:py-24">
    <div class="mx-auto max-w-4xl px-5 lg:px-8 space-y-16">
      <div class="reveal text-center">
        <div class="rounded-2xl overflow-hidden shadow-xl border border-line inline-block">
          <img src={imgSrc('swimmingNotice')} alt={imgAlt('swimmingNotice')} class="w-full h-auto" />
        </div>
        <div class="mt-6">
          <a href={EXTERNAL.kakao} target="_blank" rel="noopener" class="px-8 py-3.5 text-[14px] font-semibold text-white bg-ink hover:bg-sand-dark rounded-full transition-colors">강습 문의 (카카오톡)</a>
        </div>
      </div>

      <div class="reveal">
        <h2 class="text-xl lg:text-2xl font-bold text-ink text-center">수영 강습 스케줄</h2>
        <p class="mt-3 text-center text-[13px] text-muted">공휴일에는 수영강습을 진행하지 않습니다.</p>
        <div class="mt-8 rounded-2xl overflow-hidden shadow-xl border border-line">
          <img src={imgSrc('swimmingSchedule')} alt={imgAlt('swimmingSchedule')} class="w-full h-auto" />
        </div>
      </div>

      <div class="reveal p-6 bg-cream rounded-xl text-center">
        <p class="text-[15px] font-semibold text-ink">성인회원 자유수영 가능시간 안내</p>
        <p class="mt-2 text-[14px] text-ink-soft">자유수영 가능시간은 매월 스케줄에 따라 운영되며, 자세한 사항은 프론트 또는 고객센터로 문의해 주세요.</p>
      </div>
    </div>
  </section>
</Base>
