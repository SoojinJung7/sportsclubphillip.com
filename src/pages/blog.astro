---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { EXTERNAL } from '../data/site';
import c from '../../content/pages/blog.json';
---

<Base title={c.pageTitle}>
  <PageHero eyebrow="Blog" title={c.title}
    subtitle={c.subtitle} />

  <section class="py-16 lg:py-24">
    <div class="mx-auto max-w-2xl px-5 lg:px-8 text-center reveal">
      <p class="text-[15px] lg:text-base leading-relaxed text-ink-soft">
        {c.body}
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={EXTERNAL.naverBlog} target="_blank" rel="noopener" class="px-8 py-3.5 text-[14px] font-semibold text-white bg-ink hover:bg-sand-dark rounded-full transition-colors">{c.naverBlog}</a>
        <a href={EXTERNAL.instagram} target="_blank" rel="noopener" class="px-8 py-3.5 text-[14px] font-semibold text-ink border border-line hover:border-sand rounded-full transition-colors">{c.instagram}</a>
      </div>
    </div>
  </section>
</Base>
