---
import BrandPage from '../components/BrandPage.astro';
---

<BrandPage
  pageTitle="사단법인대한필라테스협회 ㅣ 스포츠클럽필립"
  eyebrow="Korea Pilates Association"
  title="사단법인대한필라테스협회"
  subtitle="국내 최초 사단법인 필라테스 교육기관"
  logo="kpaAssociation"
  intro="국내 최초 사단법인 필라테스 교육기관, 사단법인 대한필라테스협회"
  paragraphs={[
    "사단법인 대한필라테스협회는 우리나라 최초의 사단법인 필라테스 교육기관으로 필라테스 운동법을 국내에 알리고 홍보해왔습니다. 해부학, 생리학, 필라테스 동작들의 이점 및 특징을 철저히 교육하여 단순히 운동법을 가르치는 것이 아닌, 사람마다 다른 체형들에 알맞은 동작들을 정확히 알고 선정하여 가르칩니다. 또한 필라테스 지도자과정 교육을 통해 필라테스의 대중화에 기여하기 위해 노력해 오고 있습니다.",
    "2003년 12월 호주 필라테스협회(APMA, Australian Pilates Method Association)의 방문으로 국내 최초 필라테스 세미나를 개최한 후 이를 기반으로 대한필라테스협회가 설립되었습니다. 그 후 활발한 교육활동을 하고 있으며, 협회 내 자체적인 교육 프로그램을 개발하고 국내외 전문가를 초빙한 다양한 세미나를 개최함으로써 경쟁력 있는 지도자를 육성하고자 노력하고 있습니다.",
  ]}
  links={[{ label: '홈페이지 바로가기', href: 'https://www.koreapilates.or.kr/', external: true }]}
/>
