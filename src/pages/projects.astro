---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Img from '../components/Img.astro';
import type { ImgKey } from '../data/site';
import c from '../../content/pages/projects.json';

const facilities: { key: ImgKey; en: string; href?: string }[] = [
  { key: 'facilityHealth', en: 'Health & PT' },
  { key: 'facilityGolf', en: 'Screen Golf' },
  { key: 'facilitySwim', en: 'Swimming & Aqua' },
  { key: 'facilityGx', en: 'Group Exercise' },
  { key: 'facilityAiCircuit', en: 'AI Circuit' },
  { key: 'facilityPilates', en: 'Pilates & Gyrotonic®', href: '/pilates' }, // 시설 상세 페이지 버튼
  { key: 'facilityYouth', en: 'Youth Sports' },
  { key: 'facilitySauna', en: 'Sauna' },
];
---

<Base title={c.title}>
  <PageHero eyebrow="Facilities / Programs" title={c.hero.title}
    subtitle={c.hero.subtitle} />

  <section class="py-16 lg:py-24">
    <div class="mx-auto max-w-6xl px-5 lg:px-8 space-y-20 lg:space-y-28">
      {facilities.map((f, i) => (
        <div class:list={['grid lg:grid-cols-2 gap-8 lg:gap-14 items-center reveal', i % 2 === 1 && 'lg:[&>*:first-child]:order-2']}>
          <div class="rounded-2xl overflow-hidden shadow-lg aspect-[5/4]">
            <Img k={f.key} class="w-full h-full object-cover" />
          </div>
          <div>
            <p class="eyebrow text-[12px] text-sand-dark font-semibold">{f.en}</p>
            <h2 class="mt-3 text-2xl lg:text-3xl font-bold text-ink">{c.facilities[i].name}</h2>
            <div class="mt-4 w-10 h-px bg-sand"></div>
            <p class="mt-5 text-[15px] lg:text-base leading-loose text-ink-soft">{c.facilities[i].desc}</p>
            {f.href && (c.facilities[i] as { cta?: string }).cta && (
              <a href={f.href} class="inline-flex items-center gap-2 mt-7 px-7 py-3 text-[14px] font-semibold text-white bg-ink hover:bg-sand-dark rounded-full transition-colors">
                {(c.facilities[i] as { cta?: string }).cta}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>
</Base>
