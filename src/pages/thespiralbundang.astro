---
import BrandPage from '../components/BrandPage.astro';
import { EXTERNAL } from '../data/site';
---

<BrandPage
  pageTitle="더스파이럴분당 ㅣ 스포츠클럽필립"
  eyebrow="The Spiral Bundang"
  title="더스파이럴분당"
  subtitle="분당 최초 자이로토닉® 교육센터 더 스파이럴 분당"
  logo="spiralLogo"
  intro="분당 자이로토닉 교육기관, 더스파이럴분당"
  paragraphs={[
    "자이로토닉 메소드(Gyrotonic Method)는 신체 전체를 조화롭게 다루는 독창적이고 유일한 움직임 방식입니다. 이 방법은 에너지 경로를 열고, 신경계를 자극하며, 가동 범위를 증가시키고, 근력을 향상시키며, 움직임의 효율성을 높이는 데 초점을 맞추고 있습니다.",
    "자이로토닉 운동은 각 동작이 다음 동작으로 자연스럽게 연결되며, 충격이나 압박 없이 관절이 자연스러운 가동 범위 안에서 움직이도록 유도합니다. 이러한 정교한 시퀀스는 신체의 균형, 효율성, 근력 및 유연성을 동시에 향상시킵니다.",
    "더 스파이럴 분당은 자이로토닉 국제인증강사 교육기관으로, 자이로토닉 인증 강사 과정 중 프리트레이닝 코스를 진행하고 있는 분당 최초 자이로토닉® 교육센터입니다.",
  ]}
  links={[{ label: '자이로토닉 문의하기', href: EXTERNAL.kakao, external: true }]}
/>
