---
import BrandPage from '../components/BrandPage.astro';
import { EXTERNAL } from '../data/site';
import c from '../../content/pages/thespiralbundang.json';
---

<BrandPage
  pageTitle={c.pageTitle}
  eyebrow="The Spiral Bundang"
  title={c.title}
  subtitle={c.subtitle}
  logo="spiralLogo"
  intro={c.intro}
  paragraphs={c.paragraphs}
  links={[{ label: c.links.inquiry, href: EXTERNAL.kakao, external: true }]}
/>
