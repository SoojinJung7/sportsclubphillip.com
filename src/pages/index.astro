---
import Base from '../layouts/Base.astro';
import PromoPopup from '../components/PromoPopup.astro';
import LiveToday from '../components/LiveToday.astro';
import { EXTERNAL } from '../data/site';
import Img from '../components/Img.astro';
import c from '../../content/pages/home.json';

const facilities = [
  { key: 'facilityHealth', href: '/projects' },
  { key: 'facilityGolf', href: '/projects' },
  { key: 'facilitySwim', href: '/projects' },
  { key: 'facilityGx', href: '/projects' },
  { key: 'facilityAiCircuit', href: '/projects' },
  { key: 'facilityPilates', href: '/projects' },
  { key: 'facilityYouth', href: '/projects' },
  { key: 'facilitySauna', href: '/projects' },
] as const;

const programs = [
  { key: 'facilityGx', tag: 'GROUP EXERCISE', href: '/schedule' },
  { key: 'facilityPilates', tag: 'KOREA PILATES ASSOCIATION', href: '/kpa' },
  { key: 'homeFeatureFitness', tag: 'ACADEMY', href: '/academy' },
] as const;
---

<Base>
  <!-- ============================ HERO ============================ -->
  <section class="relative min-h-[92vh] flex items-center overflow-hidden">
    <div class="absolute inset-0">
      <Img k="homeAiWide" class="w-full h-full object-cover" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/45 to-black/20"></div>
    </div>
    <div class="relative mx-auto max-w-7xl px-5 lg:px-8 w-full">
      <div class="max-w-2xl text-white">
        <p class="eyebrow text-[12px] lg:text-[13px] text-sand font-semibold reveal">{c.hero.eyebrow}</p>
        <h1 class="mt-6 text-4xl lg:text-6xl font-bold leading-[1.12] reveal">
          Beyond Fitness,<br />Into Lifestyle
        </h1>
        <p class="mt-6 text-lg lg:text-xl text-white/85 reveal">피트니스를 넘어, 라이프스타일로</p>
        <p class="mt-5 max-w-xl text-[15px] leading-relaxed text-white/70 reveal">{c.hero.desc}</p>
        <div class="mt-9 flex flex-wrap gap-3 reveal">
          <a href="/projects" class="px-7 py-3.5 text-[14px] font-semibold text-ink bg-white hover:bg-cream rounded-full transition-colors">{c.hero.ctaFacilities}</a>
          <a href={EXTERNAL.naverBooking} target="_blank" rel="noopener"
             class="px-7 py-3.5 text-[14px] font-semibold text-white border border-white/40 hover:bg-white/10 rounded-full transition-colors">{c.hero.ctaBooking}</a>
        </div>
      </div>
    </div>
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 text-white/50 text-[11px] tracking-[0.3em] animate-pulse">SCROLL</div>
  </section>

  <!-- ============================ LIVE TODAY ============================ -->
  <LiveToday />

  <!-- ============================ MISSION ============================ -->
  <section class="py-24 lg:py-32">
    <div class="mx-auto max-w-4xl px-5 lg:px-8 text-center">
      <p class="eyebrow text-[12px] text-sand-dark font-semibold reveal">Beyond Fitness, Into Lifestyle</p>
      <h2 class="mt-5 text-2xl lg:text-4xl font-bold leading-snug text-ink reveal">
        {c.mission.titleLine1}<br class="hidden lg:block" /> {c.mission.titleLine2}
      </h2>
      <div class="mt-8 space-y-5 text-[15px] lg:text-[17px] leading-loose text-ink-soft reveal">
        <p>{c.mission.p1}</p>
        <p>{c.mission.p2}</p>
      </div>
    </div>
  </section>

  <!-- ============================ FACILITIES ============================ -->
  <section class="py-20 lg:py-28 bg-cream">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="text-center max-w-2xl mx-auto">
        <p class="eyebrow text-[12px] text-sand-dark font-semibold reveal">Total Wellness, One Place</p>
        <h2 class="mt-4 text-2xl lg:text-4xl font-bold text-ink reveal">{c.facilities.heading}</h2>
        <p class="mt-5 text-[15px] leading-relaxed text-ink-soft reveal">{c.facilities.intro}</p>
      </div>
      <div class="mt-14 grid grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-5">
        {facilities.map((f, i) => (
          <a href={f.href} class="group relative aspect-[4/5] rounded-lg overflow-hidden reveal">
            <Img k={f.key} alt={c.facilities.items[i]} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/10 to-transparent"></div>
            <div class="absolute inset-x-0 bottom-0 p-4 lg:p-5">
              <h3 class="text-white font-semibold text-[15px] lg:text-lg">{c.facilities.items[i]}</h3>
              <span class="mt-1 inline-block text-white/70 text-[12px] tracking-wider opacity-0 group-hover:opacity-100 transition-opacity">VIEW →</span>
            </div>
          </a>
        ))}
      </div>
      <div class="mt-12 text-center reveal">
        <a href="/projects" class="inline-flex items-center gap-2 px-8 py-3.5 text-[14px] font-semibold text-white bg-ink hover:bg-sand-dark rounded-full transition-colors">
          {c.facilities.ctaAll} <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============================ PROGRAMS ============================ -->
  <section class="py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="text-center max-w-2xl mx-auto">
        <p class="eyebrow text-[12px] text-sand-dark font-semibold reveal">Move, Grow, Excel</p>
        <h2 class="mt-4 text-2xl lg:text-4xl font-bold text-ink reveal">{c.programs.heading}</h2>
      </div>
      <div class="mt-14 grid gap-6 md:grid-cols-3">
        {programs.map((p, i) => (
          <a href={p.href} class="group block bg-white border border-line rounded-xl overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all duration-300 reveal">
            <div class="aspect-[16/10] overflow-hidden bg-cream">
              <Img k={p.key} alt={c.programs.items[i].title} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
            </div>
            <div class="p-6">
              <p class="eyebrow text-[11px] text-sand-dark font-semibold">{p.tag}</p>
              <h3 class="mt-3 text-xl font-bold text-ink">{c.programs.items[i].title}</h3>
              <p class="mt-3 text-[14px] leading-relaxed text-ink-soft">{c.programs.items[i].desc}</p>
              <span class="mt-4 inline-block text-[13px] font-semibold text-sand-dark">자세히 보기 →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================ PROMOTION ============================ -->
  <section class="py-20 lg:py-28 bg-ink text-white">
    <div class="mx-auto max-w-7xl px-5 lg:px-8 grid lg:grid-cols-2 gap-12 items-center">
      <div class="reveal">
        <p class="eyebrow text-[12px] text-sand font-semibold">This Month</p>
        <h2 class="mt-4 text-3xl lg:text-4xl font-bold">{c.promo.heading}</h2>
        <p class="mt-5 text-white/70 leading-relaxed">{c.promo.desc}</p>
        <a href="/promotion" class="mt-8 inline-flex items-center gap-2 px-8 py-3.5 text-[14px] font-semibold text-ink bg-white hover:bg-sand hover:text-white rounded-full transition-colors">
          {c.promo.cta} <span aria-hidden="true">→</span>
        </a>
      </div>
      <a href="/promotion" class="reveal block rounded-xl overflow-hidden shadow-2xl">
        <Img k="promoCurrent" class="w-full h-auto" />
      </a>
    </div>
  </section>

  <!-- ============================ CTA ============================ -->
  <section class="py-20 lg:py-24 bg-cream">
    <div class="mx-auto max-w-5xl px-5 lg:px-8 text-center">
      <h2 class="text-2xl lg:text-3xl font-bold text-ink reveal">{c.cta.heading}</h2>
      <div class="mt-10 grid grid-cols-2 md:grid-cols-4 gap-4 reveal">
        <a href="/projects" class="px-4 py-6 bg-white border border-line rounded-xl hover:border-sand hover:shadow-md transition-all">
          <span class="block text-lg font-bold text-ink">{c.cta.facilities}</span>
          <span class="mt-1 block text-[12px] text-muted">Facilities</span>
        </a>
        <a href={EXTERNAL.naverBooking} target="_blank" rel="noopener" class="px-4 py-6 bg-white border border-line rounded-xl hover:border-sand hover:shadow-md transition-all">
          <span class="block text-lg font-bold text-ink">{c.cta.booking}</span>
          <span class="mt-1 block text-[12px] text-muted">Naver Booking</span>
        </a>
        <a href={EXTERNAL.naverBlog} target="_blank" rel="noopener" class="px-4 py-6 bg-white border border-line rounded-xl hover:border-sand hover:shadow-md transition-all">
          <span class="block text-lg font-bold text-ink">{c.cta.blog}</span>
          <span class="mt-1 block text-[12px] text-muted">Naver Blog</span>
        </a>
        <a href="/challenges" class="px-4 py-6 bg-white border border-line rounded-xl hover:border-sand hover:shadow-md transition-all">
          <span class="block text-lg font-bold text-ink">{c.cta.programs}</span>
          <span class="mt-1 block text-[12px] text-muted">Programs</span>
        </a>
      </div>
    </div>
  </section>

  <PromoPopup />
</Base>
