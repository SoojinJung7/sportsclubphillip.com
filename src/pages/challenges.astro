---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { EXTERNAL, imgSrc, imgAlt } from '../data/site';

const programs = [
  {
    key: 'challenge',
    title: '스포츠 프로그램 운영을 위한 실무 과정',
    badge: '별도의 수수료 및 비용 없음',
    href: EXTERNAL.kakao,
  },
] as const;
---

<Base title="프로그램 ㅣ 스포츠클럽필립">
  <PageHero eyebrow="Programs" title="프로그램"
    subtitle="필립에서 진행되는 다양한 스포츠 프로그램과 실무 과정을 만나보세요." />

  <section class="py-16 lg:py-24">
    <div class="mx-auto max-w-4xl px-5 lg:px-8">
      <div class="grid gap-8 sm:grid-cols-2">
        {programs.map((p) => (
          <div class="group bg-white border border-line rounded-2xl overflow-hidden hover:shadow-xl transition-shadow reveal">
            <div class="aspect-[4/3] overflow-hidden bg-cream">
              <img src={imgSrc(p.key)} alt={imgAlt(p.key)} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
            <div class="p-6">
              <span class="inline-block px-3 py-1 text-[11px] font-semibold text-sand-dark bg-sand/10 rounded-full">{p.badge}</span>
              <h3 class="mt-4 text-lg font-bold text-ink leading-snug">{p.title}</h3>
              <a href={p.href} target="_blank" rel="noopener" class="mt-5 inline-flex items-center gap-1.5 text-[13px] font-semibold text-white bg-ink hover:bg-sand-dark px-5 py-2.5 rounded-full transition-colors">
                정보 보기 <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        ))}
      </div>
      <div class="mt-12 text-center reveal">
        <a href="/" class="text-[14px] font-semibold text-ink-soft hover:text-sand-dark">← 돌아가기</a>
      </div>
    </div>
  </section>
</Base>
