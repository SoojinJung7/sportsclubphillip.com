---
import BrandPage from '../components/BrandPage.astro';
import c from '../../content/pages/bally.json';
---

<BrandPage
  pageTitle={c.pageTitle}
  eyebrow="Junior Sports Education Center"
  title={c.title}
  subtitle={c.subtitle}
  logo="ballyLogo"
  intro={c.intro}
  paragraphs={c.paragraphs}
  links={[
    { label: c.links.schedule, href: 'http://www.bally-junior.com', external: true },
    { label: c.links.instagram, href: 'https://www.instagram.com/bally_junior_sports_club/', external: true },
  ]}
/>
