---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Img from '../components/Img.astro';
import c from '../../content/pages/about.json';

const brands = [
  { key: 'brandBally' },
  { key: 'brandPivot' },
  { key: 'brandWellnesphilia' },
] as const;

const history = [
  { year: '2025.03' },
  { year: '2024.02' },
  { year: '2002 ~' },
];
---

<Base title={c.title}>
  <PageHero eyebrow="About" title={c.hero.title} subtitle={c.hero.subtitle} />

  <!-- Brand story -->
  <section class="py-20 lg:py-28">
    <div class="mx-auto max-w-4xl px-5 lg:px-8">
      <p class="eyebrow text-[12px] text-sand-dark font-semibold text-center reveal">Brand Story</p>
      <h2 class="mt-4 text-2xl lg:text-3xl font-bold text-center text-ink reveal">{c.brandStory.heading}</h2>
      <div class="mt-10 space-y-6 text-[15px] lg:text-[17px] leading-loose text-ink-soft reveal">
        <p>{c.brandStory.p1}</p>
        <p>{c.brandStory.p2Prefix}<strong class="text-ink font-semibold">{c.brandStory.p2Stance}</strong>{c.brandStory.p2Mid}<strong class="text-ink font-semibold">{c.brandStory.p2Phillip}</strong>{c.brandStory.p2Suffix}</p>
      </div>
    </div>
  </section>

  <!-- History -->
  <section class="py-20 lg:py-28 bg-cream">
    <div class="mx-auto max-w-4xl px-5 lg:px-8">
      <p class="eyebrow text-[12px] text-sand-dark font-semibold text-center reveal">History</p>
      <h2 class="mt-4 text-2xl lg:text-3xl font-bold text-center text-ink reveal">{c.history.heading}</h2>
      <div class="mt-12 space-y-0">
        {history.map((h, i) => (
          <div class="flex gap-6 lg:gap-10 py-6 border-b border-line reveal">
            <div class="w-24 lg:w-32 shrink-0 text-sand-dark font-bold text-[15px] lg:text-lg">{h.year}</div>
            <div class="text-ink-soft text-[15px] lg:text-base leading-relaxed">{c.history.items[i]}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Our brands -->
  <section class="py-20 lg:py-28">
    <div class="mx-auto max-w-6xl px-5 lg:px-8">
      <p class="eyebrow text-[12px] text-sand-dark font-semibold text-center reveal">Our Brand</p>
      <h2 class="mt-4 text-2xl lg:text-3xl font-bold text-center text-ink reveal">{c.brands.heading}</h2>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {brands.map((b, i) => (
          <div class="text-center bg-white border border-line rounded-xl p-8 hover:shadow-lg transition-shadow reveal">
            <div class="h-24 flex items-center justify-center">
              <Img k={b.key} class="max-h-20 w-auto object-contain" />
            </div>
            <h3 class="mt-6 text-lg font-bold text-ink">{c.brands.items[i].name}</h3>
            <p class="mt-2 text-[14px] text-muted">{c.brands.items[i].desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
