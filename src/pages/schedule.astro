---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { imgSrc, imgAlt } from '../data/site';
// 매월 스케줄 포스터 교체: site.ts 의 scheduleOperating / scheduleGx 이미지를 교체하세요.
---

<Base title="운영일 안내 / GX스케줄 ㅣ 스포츠클럽필립">
  <PageHero eyebrow="Schedule" title="운영일 안내 / GX스케줄"
    subtitle="매달 새롭게 안내되는 영업 및 그룹 운동 스케줄을 확인하세요." />

  <section class="py-16 lg:py-24">
    <div class="mx-auto max-w-4xl px-5 lg:px-8 space-y-20">
      <div class="reveal">
        <h2 class="text-xl lg:text-2xl font-bold text-ink text-center">영업 안내 스케줄</h2>
        <p class="mt-3 text-center text-[13px] text-muted">공휴일 수영강습·GX프로그램 운영 X · 매월 1, 3, 5째주 일요일 휴관</p>
        <div class="mt-8 rounded-2xl overflow-hidden shadow-xl border border-line">
          <img src={imgSrc('scheduleOperating')} alt={imgAlt('scheduleOperating')} class="w-full h-auto" />
        </div>
      </div>

      <div class="reveal">
        <h2 class="text-xl lg:text-2xl font-bold text-ink text-center">GX 강습 스케줄</h2>
        <p class="mt-3 text-center text-[13px] text-muted">공휴일에는 GX프로그램을 운영하지 않습니다.</p>
        <div class="mt-8 rounded-2xl overflow-hidden shadow-xl border border-line">
          <img src={imgSrc('scheduleGx')} alt={imgAlt('scheduleGx')} class="w-full h-auto" />
        </div>
      </div>
    </div>
  </section>
</Base>
