---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Img from '../components/Img.astro';
import c from '../../content/pages/schedule.json';
// 매월 스케줄 포스터 교체: Pages CMS "📅 이달의 포스터" 페이지에서 영업 안내 / GX 포스터를 업로드하면 됩니다 (코드 수정 불필요).
---

<Base title={c.title}>
  <PageHero eyebrow="Schedule" title={c.hero.title}
    subtitle={c.hero.subtitle} />

  <section class="py-16 lg:py-24">
    <div class="mx-auto max-w-4xl px-5 lg:px-8 space-y-20">
      <div class="reveal">
        <h2 class="text-xl lg:text-2xl font-bold text-ink text-center">{c.operating.heading}</h2>
        <p class="mt-3 text-center text-[13px] text-muted">{c.operating.notice}</p>
        <div class="mt-8 rounded-2xl overflow-hidden shadow-xl border border-line">
          <Img k="scheduleOperating" class="w-full h-auto" />
        </div>
      </div>

      <div class="reveal">
        <h2 class="text-xl lg:text-2xl font-bold text-ink text-center">{c.gx.heading}</h2>
        <p class="mt-3 text-center text-[13px] text-muted">{c.gx.notice}</p>
        <div class="mt-8 rounded-2xl overflow-hidden shadow-xl border border-line">
          <Img k="scheduleGx" class="w-full h-auto" />
        </div>
      </div>
    </div>
  </section>
</Base>
